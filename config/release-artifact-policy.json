{
  "$schema": "../schemas/release-artifact-policy.schema.json",
  "schema_version": "agentic-sdlc.release-artifact-policy.v1",
  "archive_limits": {
    "max_compressed_bytes": 16777216,
    "max_component_bytes": 255,
    "max_entries": 4096,
    "max_file_bytes": 8388608,
    "max_path_bytes": 240,
    "max_pax_bytes": 16384,
    "max_total_file_bytes": 67108864,
    "max_uncompressed_bytes": 83886080
  },
  "package": {
    "name": "agentic-sdlc-codex-plugin",
    "archive_root": "package",
    "tag_prefix": "v",
    "allowed_top_level": [
      ".claude-plugin",
      ".codex-plugin",
      "LICENSE",
      "README.md",
      "assets",
      "bin",
      "commands",
      "config",
      "docs",
      "lib",
      "package.json",
      "schemas",
      "scripts",
      "skills",
      "templates",
      "ui"
    ],
    "required_files": [
      ".claude-plugin/marketplace.json",
      ".claude-plugin/plugin.json",
      ".codex-plugin/plugin.json",
      "LICENSE",
      "README.md",
      "bin/agentic-sdlc.mjs",
      "config/release-artifact-policy.json",
      "lib/build-identity.mjs",
      "package.json",
      "schemas/profile-task-start-receipt-v1.schema.json",
      "schemas/project-bootstrap-journal.schema.json",
      "schemas/project-bootstrap-manifest.schema.json",
      "schemas/release-artifact-policy.schema.json",
      "schemas/workflow-final-gate-receipt-v1.schema.json",
      "schemas/workflow-final-gate-receipt.schema.json",
      "schemas/workflow-strict-gate-receipt.schema.json",
      "scripts/install-personal-marketplace-v2.py",
      "scripts/install-personal-marketplace.py",
      "scripts/verify-release-package.mjs",
      "skills/agentic-sdlc/SKILL.md"
    ],
    "plugin_manifest": ".codex-plugin/plugin.json",
    "installer": "scripts/install-personal-marketplace-v2.py",
    "bin": {
      "agentic-sdlc": "./bin/agentic-sdlc.mjs"
    },
    "forbidden_lifecycle_scripts": [
      "dependencies",
      "install",
      "postdependencies",
      "postinstall",
      "postpack",
      "postprepare",
      "postpublish",
      "postuninstall",
      "postversion",
      "predependencies",
      "preinstall",
      "prepack",
      "preprepare",
      "prepare",
      "prepublish",
      "prepublishOnly",
      "preuninstall",
      "preversion",
      "publish",
      "uninstall",
      "version"
    ]
  }
}
