{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.schema.json",
  "title": "Agentic SDLC Story",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "phase",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "analysis",
        "design",
        "implementation",
        "in_progress",
        "review",
        "validation",
        "release",
        "done",
        "blocked"
      ]
    },
    "phase": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "contract_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_review_required": {
      "type": "object",
      "required": [
        "schema_version",
        "reason",
        "contract_id",
        "previous_story_hash",
        "added_acceptance_criteria",
        "changed_at"
      ],
      "properties": {
        "schema_version": {
          "const": "story-contract-review:v1"
        },
        "reason": {
          "const": "acceptance_criteria_changed"
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "previous_story_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "added_acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "requirement_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "path", "content_hash", "revision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "revision": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "autonomy_ceiling": {
      "enum": ["supervised", "checkpointed", "bounded-autonomous"]
    },
    "work_breakdown_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Human-readable alias for acceptance_criteria. acceptance_criteria remains the canonical gate field."
    },
    "derived_acceptance": {
      "type": "array",
      "description": "Secondary verification criteria derived from the verification policy; explicit acceptance criteria keep priority.",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "verification_type", "text", "source", "priority"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rule_id": { "type": "string", "minLength": 1 },
          "verification_type": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "source": { "const": "derived" },
          "priority": { "const": "secondary" },
          "evidence_patterns": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "derived_verification": {
      "type": "object",
      "description": "How the derived criteria were computed: policy hash, scope, enforcement (warn or block), opt-out, and rules already covered by an explicit criterion.",
      "required": ["schema_version", "disabled", "enforce"],
      "properties": {
        "schema_version": { "const": "derived-verification:v1" },
        "policy_hash": { "type": "string" },
        "mode": { "enum": ["new", "backfill"] },
        "disabled": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "enforce": { "enum": ["warn", "block", null] },
        "scope": { "type": "object" },
        "covered_by_explicit": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "properties": {
        "created_by": {
          "type": "object",
          "additionalProperties": true
        },
        "updated_by": {
          "type": "object",
          "additionalProperties": true
        },
        "git": {
          "type": "object",
          "additionalProperties": true
        },
        "run": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
