{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Agentic SDLC Project",
  "type": "object",
  "required": [
    "project_id",
    "project_name",
    "schema_version",
    "sdlc_version",
    "knowledge_base"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "sdlc_version": {
      "type": "string"
    },
    "locale": {
      "description": "Preferred language for human-readable output, recorded when the project is initialized with --locale.",
      "enum": [
        "en",
        "it"
      ]
    },
    "bootstrap_manifest": {
      "type": "object",
      "required": [
        "path",
        "schema_version"
      ],
      "properties": {
        "path": {
          "const": ".sdlc/bootstrap-manifest.json"
        },
        "schema_version": {
          "const": "project-bootstrap-manifest:v1"
        }
      },
      "additionalProperties": false
    },
    "bootstrap_journal": {
      "type": "object",
      "required": [
        "path",
        "schema_version",
        "request_hash"
      ],
      "properties": {
        "path": {
          "const": ".sdlc/bootstrap-journal.json"
        },
        "schema_version": {
          "const": "project-bootstrap-journal:v1"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "knowledge_base": {
      "type": "object",
      "properties": {
        "storage": {
          "type": "string"
        },
        "canonical_path": {
          "type": "string"
        },
        "stateless_plugin": {
          "type": "boolean"
        },
        "concurrency_model": {
          "type": "string"
        },
        "source_of_truth": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "derived_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_contracts_registry": {
          "type": "string",
          "default": ".sdlc/output-contracts/registry.json"
        },
        "cache_policy_path": {
          "type": "string",
          "default": ".sdlc/cache/kb-cache.json"
        }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "properties": {
        "created_by": {
          "type": "object",
          "additionalProperties": true
        },
        "updated_by": {
          "type": "object",
          "additionalProperties": true
        },
        "git": {
          "type": "object",
          "additionalProperties": true
        },
        "run": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
