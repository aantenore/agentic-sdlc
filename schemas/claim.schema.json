{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Agentic SDLC Story Claim",
  "type": "object",
  "required": [
    "story_id",
    "agent",
    "branch",
    "status",
    "claimed_at"
  ],
  "properties": {
    "story_id": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "released",
        "transferred",
        "cancelled"
      ]
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization_ref": {
      "description": "Exact authorization consumed when story.claim is a configured delivery checkpoint.",
      "type": "string"
    },
    "authorization_use_ref": {
      "description": "Historical-at-use receipt proving authority for this exact story.claim action.",
      "type": "string"
    },
    "authorization_action": {
      "const": "story.claim"
    },
    "checkpoint_profile_ref": {
      "description": "Immutable delivery profile that required the story.claim checkpoint.",
      "$ref": "#/$defs/hashed_ref"
    },
    "shared_claim": {
      "description": "The same claim as recorded for every computer: a create-only ref on the project's git remote, made before this file was written.",
      "type": "object",
      "required": [
        "scope",
        "remote",
        "ref",
        "epoch",
        "claimant_id"
      ],
      "properties": {
        "scope": {
          "const": "shared"
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "remote_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/agentic-sdlc/claims/[^/]+/[0-9]{6}/claim$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "claimant_id": {
          "type": "string",
          "minLength": 1
        },
        "takeover_of": {
          "description": "The claim held elsewhere that a person took over to make this one.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "hashed_ref": {
      "type": "object",
      "required": [
        "id",
        "path",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "dependentRequired": {
    "authorization_ref": [
      "authorization_use_ref",
      "authorization_action",
      "checkpoint_profile_ref"
    ],
    "authorization_use_ref": [
      "authorization_ref",
      "authorization_action",
      "checkpoint_profile_ref"
    ],
    "authorization_action": [
      "authorization_ref",
      "authorization_use_ref",
      "checkpoint_profile_ref"
    ],
    "checkpoint_profile_ref": [
      "authorization_ref",
      "authorization_use_ref",
      "authorization_action"
    ]
  },
  "additionalProperties": true
}
