{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secret-scan.schema.json",
  "title": "Agentic SDLC Secret Scan Record v1",
  "description": "Persistent evidence that the exact files one delivery changed were searched for credentials, binding the scanned head commit, the compared base, the file count, the identity of the rule set, and every finding in redacted form. A finding never carries the matched value: only the rule that matched, the file, the line, and a redacted prefix. An outcome of 'clean' is only representable together with an empty finding list, so the record cannot be satisfied by asserting that nothing was found.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "id",
    "story_id",
    "summary",
    "base_sha",
    "head_sha",
    "source",
    "file_count",
    "scanned_paths",
    "rule_set_hash",
    "rule_ids",
    "findings",
    "outcome",
    "started_at",
    "finished_at",
    "actor",
    "git",
    "run",
    "created_at",
    "audit",
    "record_hash",
    "hash_algorithm"
  ],
  "properties": {
    "kind": {
      "const": "secret_scan"
    },
    "schema_version": {
      "const": "secret-scan:v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "delivery_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "description": "The commit the changed files were compared against. Null when the changed files come from the story's recorded write paths instead of a commit range.",
      "oneOf": [
        {
          "$ref": "#/$defs/git_sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "head_sha": {
      "description": "The commit whose content was scanned, or null in a project that is not a Git worktree. The validation gate accepts a record only while this matches the project's current head.",
      "oneOf": [
        {
          "$ref": "#/$defs/git_sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "description": "How the scanned file list was resolved: a committed range, the uncommitted workspace, or the story's recorded write paths.",
      "enum": [
        "git_range",
        "git_workspace",
        "story_write_paths"
      ]
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "scanned_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule_set_hash": {
      "$ref": "#/$defs/sha256"
    },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "outcome": {
      "enum": [
        "clean",
        "findings"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "git": {
      "$ref": "common.schema.json#/$defs/git"
    },
    "run": {
      "$ref": "common.schema.json#/$defs/run"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit": {
      "$ref": "common.schema.json#/$defs/audit"
    },
    "record_hash": {
      "$ref": "#/$defs/sha256"
    },
    "hash_algorithm": {
      "const": "sha256:stable-json:v1"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "clean"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "finding": {
      "description": "One match, recorded without the matched value. redacted_match keeps at most four leading characters followed by an ellipsis so two findings on one line stay distinguishable without storing the credential.",
      "type": "object",
      "required": [
        "path",
        "line",
        "rule",
        "redacted_match"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "redacted_match": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5,
          "pattern": "\\u2026$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
