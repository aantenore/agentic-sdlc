{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestration.schema.json",
  "title": "Agentic SDLC Orchestration Snapshot",
  "type": "object",
  "required": [
    "checked_at",
    "summary",
    "stories"
  ],
  "properties": {
    "checked_at": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "orchestration_state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "orchestration_state": {
            "enum": [
              "available",
              "claimed",
              "blocked",
              "stale",
              "terminal",
              "closed"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "closure": {
            "type": "object",
            "description": "Present only for superseded or cancelled stories.",
            "required": ["id", "event", "replacement_id", "path"],
            "properties": {
              "id": { "type": "string" },
              "event": { "enum": ["superseded", "cancelled"] },
              "replacement_id": { "type": ["string", "null"] },
              "breakdown_id": { "type": ["string", "null"] },
              "path": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "locks": {
      "type": "array"
    },
    "handoffs": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
