{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-closure.schema.json",
  "title": "Agentic SDLC Story Closure",
  "description": "Immutable, approved record that closes a story as superseded by another story or as cancelled. A never-started story closes directly; a started story closes only when every bound delivery ended without delivered work, and the closure binds that evidence. The story record itself is never rewritten.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "schema_version",
    "event",
    "status",
    "story_id",
    "replacement_id",
    "subject",
    "approval",
    "created_at",
    "audit"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "story_closure" },
    "schema_version": { "const": "story-closure:v1" },
    "event": { "enum": ["superseded", "cancelled"] },
    "status": { "enum": ["superseded", "cancelled"] },
    "story_id": { "type": "string", "minLength": 1 },
    "replacement_id": { "type": ["string", "null"] },
    "subject": {
      "type": "object",
      "required": ["event", "stories", "replacement", "breakdown", "reason"],
      "properties": {
        "event": { "enum": ["superseded", "cancelled"] },
        "stories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ref" }
        },
        "replacement": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ref" }
          ]
        },
        "breakdown": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ref" }
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "started_work": { "$ref": "#/$defs/started_work" }
      },
      "additionalProperties": false
    },
    "approval": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" },
    "audit": { "$ref": "common.schema.json#/$defs/audit" }
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "started_work": {
      "type": "object",
      "required": ["story_id", "task_start", "deliveries", "claim"],
      "properties": {
        "story_id": { "type": "string", "minLength": 1 },
        "task_start": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/file_ref" }
          ]
        },
        "deliveries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "profile_hash", "terminal_status", "close_receipt"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "profile_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "terminal_status": { "enum": ["cancelled", "closed", "revoked", "rolled_back", "superseded"] },
              "close_receipt": { "$ref": "#/$defs/file_ref" }
            },
            "additionalProperties": false
          }
        },
        "claim": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["path", "agent", "status_before"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "agent": { "type": ["string", "null"] },
                "status_before": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "required": ["id", "path", "content_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
