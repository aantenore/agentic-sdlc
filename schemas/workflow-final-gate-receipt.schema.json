{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-final-gate-receipt.schema.json",
  "title": "Governed terminal workflow lifecycle receipt",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "status",
    "strict",
    "scope",
    "lifecycle_complete",
    "certification_level",
    "lifecycle_workflow",
    "freshness_proof",
    "story_id",
    "checked_at",
    "errors",
    "final_receipt_path",
    "hash_algorithm",
    "receipt_hash"
  ],
  "properties": {
    "kind": { "const": "workflow_final_gate_receipt" },
    "schema_version": { "const": "workflow-final-gate-receipt:v3" },
    "status": { "const": "passed" },
    "strict": { "const": true },
    "scope": { "const": "story" },
    "lifecycle_complete": { "const": true },
    "certification_level": { "const": "lifecycle_complete" },
    "lifecycle_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_policy",
        "story_id",
        "instance_id",
        "instance_hash",
        "effective_hash",
        "checkpoint_ref",
        "terminal_state",
        "terminal_event_ref",
        "event_count",
        "task_start_ref",
        "phase_timeline",
        "release_trace_at",
        "delivery_closed_at"
      ],
      "properties": {
        "selection_policy": { "const": "latest-created-at-then-instance-id:v1" },
        "story_id": { "type": "string", "minLength": 1 },
        "instance_id": { "type": "string", "minLength": 1 },
        "instance_hash": { "$ref": "#/$defs/hash" },
        "effective_hash": { "$ref": "#/$defs/hash" },
        "checkpoint_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "checkpoint_hash",
            "sequence",
            "last_event_hash",
            "trace_chain_hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.sdlc/workflows/instances/[A-Za-z0-9._-]+/checkpoint\\.json$"
            },
            "checkpoint_hash": { "$ref": "#/$defs/hash" },
            "sequence": { "type": "integer", "minimum": 1 },
            "last_event_hash": { "$ref": "#/$defs/hash" },
            "trace_chain_hash": { "$ref": "#/$defs/hash" }
          }
        },
        "terminal_state": { "type": "string", "minLength": 1 },
        "terminal_event_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_hash", "sequence", "timestamp"],
          "properties": {
            "event_hash": { "$ref": "#/$defs/hash" },
            "sequence": { "type": "integer", "minimum": 1 },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "event_count": { "type": "integer", "minimum": 1 },
        "task_start_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "hash", "confirmed_at"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "path": {
              "type": "string",
              "pattern": "^\\.sdlc/stories/[A-Za-z0-9._-]+/task-start\\.json$"
            },
            "hash": { "$ref": "#/$defs/hash" },
            "confirmed_at": { "type": "string", "format": "date-time" }
          }
        },
        "phase_timeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "entered_at",
              "entry_event_hash",
              "completed_at",
              "completion_record_id"
            ],
            "properties": {
              "phase": { "type": "string", "minLength": 1 },
              "entered_at": { "type": "string", "format": "date-time" },
              "entry_event_hash": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "#/$defs/hash" }
                ]
              },
              "completed_at": { "type": "string", "format": "date-time" },
              "completion_record_id": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inherited_phases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "release_trace_at": { "type": "string", "format": "date-time" },
        "delivery_closed_at": { "type": "string", "format": "date-time" }
      }
    },
    "freshness_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "story_id",
        "workflow_instance_id",
        "governed_files",
        "output_registry_projection",
        "local_release_root",
        "local_release_scope",
        "git_scope",
        "hash_algorithm",
        "proof_hash"
      ],
      "properties": {
        "schema_version": { "const": "workflow-final-freshness-proof:v2" },
        "story_id": { "type": "string", "minLength": 1 },
        "workflow_instance_id": { "type": "string", "minLength": 1 },
        "governed_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file_ref" }
        },
        "output_registry_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.sdlc/output-contracts/registry\\.json#story=[A-Za-z0-9._-]+$"
            },
            "sha256": { "$ref": "#/$defs/hash" }
          }
        },
        "local_release_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "present",
              "kind",
              "file_count",
              "entry_count",
              "total_bytes",
              "tree_hash"
            ],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "present": { "type": "boolean" },
              "kind": { "enum": ["missing", "regular", "directory"] },
              "file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
              "entry_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
              "total_bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
              "tree_hash": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "local_release_root": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "present",
                "kind",
                "real_path",
                "device",
                "inode",
                "mode"
              ],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "present": { "type": "boolean" },
                "kind": { "enum": ["missing", "directory"] },
                "real_path": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "minLength": 1 }
                  ]
                },
                "device": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "minLength": 1 }
                  ]
                },
                "inode": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "minLength": 1 }
                  ]
                },
                "mode": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "integer", "minimum": 0 }
                  ]
                }
              }
            }
          ]
        },
        "git_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "available",
            "baseline_head_sha",
            "certification_head_sha",
            "scoped_state_hash",
            "scoped_head_tree_hash",
            "scoped_changes"
          ],
          "properties": {
            "schema_version": { "const": "workflow-final-git-scope:v2" },
            "available": { "type": "boolean" },
            "baseline_head_sha": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
              ]
            },
            "baseline_tree": {
              "description": "Empty tree a delivery that started before the first commit was compared with; present only then, together with a null baseline_head_sha.",
              "type": "string",
              "pattern": "^[a-f0-9]{40,64}$"
            },
            "certification_head_sha": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
              ]
            },
            "anchor": {
              "description": "Commit the scope was certified on instead of the working tree: the merge commit of a merged pull-request story. Absent for every other certification.",
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sha"],
              "properties": {
                "kind": { "const": "merge_commit" },
                "sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
              }
            },
            "scoped_state_hash": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/hash" }
              ]
            },
            "scoped_head_tree_hash": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/hash" }
              ]
            },
            "scoped_changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "working_tree",
                  "index",
                  "head",
                  "index_matches_worktree",
                  "index_matches_head",
                  "index_flags"
                ],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "working_tree": { "$ref": "#/$defs/git_file_identity" },
                  "index": { "$ref": "#/$defs/git_file_identity" },
                  "head": { "$ref": "#/$defs/git_file_identity" },
                  "index_matches_worktree": { "type": "boolean" },
                  "index_matches_head": { "type": "boolean" },
                  "index_flags": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["assume_unchanged", "skip_worktree"],
                    "properties": {
                      "assume_unchanged": { "const": false },
                      "skip_worktree": { "const": false }
                    }
                  }
                }
              }
            }
          }
        },
        "hash_algorithm": { "const": "sha256:stable-json:v1" },
        "proof_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "story_id": { "type": "string", "minLength": 1 },
    "checked_at": { "type": "string", "format": "date-time" },
    "errors": {
      "type": "array",
      "maxItems": 0
    },
    "final_receipt_path": {
      "type": "string",
      "pattern": "^\\.sdlc/gates/[A-Za-z0-9._-]+-final\\.json$"
    },
    "hash_algorithm": { "const": "sha256:stable-json:v1" },
    "receipt_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "file_type",
        "mode",
        "content_sha256",
        "object_id"
      ],
      "properties": {
        "present": { "type": "boolean" },
        "file_type": { "enum": ["regular", "symlink", "missing"] },
        "mode": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "content_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/hash" }
          ]
        },
        "object_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
          ]
        }
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "path",
        "present",
        "file_type",
        "mode",
        "sha256"
      ],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "present": { "type": "boolean" },
        "file_type": { "enum": ["regular", "directory", "missing"] },
        "mode": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/hash" }
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
