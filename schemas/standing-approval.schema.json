{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standing-approval.schema.json",
  "title": "Standing approval: a bounded, revocable delegation for repeated low-risk deliveries",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "id",
    "status",
    "work_kind",
    "scope",
    "requirement_refs",
    "allowed_write_paths",
    "limits",
    "destination",
    "delivery_level",
    "covered_actions",
    "never_covered",
    "max_deliveries",
    "valid_from",
    "expires_at",
    "budget",
    "bindings",
    "created_at",
    "audit",
    "record_hash",
    "hash_algorithm"
  ],
  "properties": {
    "kind": { "const": "standing_approval" },
    "schema_version": { "const": "standing-approval:v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "status": { "const": "proposed" },
    "work_kind": {
      "type": "object",
      "required": ["recipe_id", "description"],
      "properties": {
        "recipe_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["project_id", "project_root"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "project_root": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "profile_id", "profile_hash"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "profile_id": { "type": "string", "minLength": 1 },
          "profile_hash": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "allowed_write_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limits": {
      "type": "object",
      "required": ["max_changed_files", "max_changed_lines"],
      "properties": {
        "max_changed_files": { "type": "integer", "minimum": 1 },
        "max_changed_lines": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": ["kind", "merge_allowed", "deploy_allowed", "production_allowed"],
      "properties": {
        "kind": { "enum": ["local_release", "pull_request"] },
        "merge_allowed": { "const": false },
        "deploy_allowed": { "const": false },
        "production_allowed": { "const": false },
        "repository": { "type": "string", "minLength": 3, "maxLength": 512 },
        "head_branch_prefix": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*/$"
        }
      },
      "if": { "properties": { "kind": { "const": "pull_request" } } },
      "then": { "required": ["repository", "head_branch_prefix"] },
      "else": { "not": { "anyOf": [{ "required": ["repository"] }, { "required": ["head_branch_prefix"] }] } },
      "additionalProperties": false
    },
    "delivery_level": { "const": "checkpointed" },
    "covered_actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "never_covered": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "max_deliveries": { "type": "integer", "minimum": 1 },
    "valid_from": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "budget": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["currency", "per_delivery_amount", "total_amount"],
          "properties": {
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "per_delivery_amount": { "$ref": "#/$defs/budget_amount" },
            "total_amount": { "$ref": "#/$defs/budget_amount" }
          },
          "additionalProperties": false
        }
      ]
    },
    "coordination": {
      "type": "object",
      "required": ["scope", "remote", "remote_fingerprint"],
      "properties": {
        "scope": { "enum": ["shared", "local"] },
        "remote": { "type": ["string", "null"], "maxLength": 64 },
        "remote_fingerprint": { "type": ["string", "null"], "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "required": ["config_hash", "policy_hash", "project_hash"],
      "properties": {
        "config_hash": { "$ref": "#/$defs/sha256" },
        "policy_hash": { "$ref": "#/$defs/sha256" },
        "project_hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string", "format": "date-time" },
    "audit": {
      "type": "object",
      "required": ["proposed_by"],
      "properties": {
        "proposed_by": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/actor" }] }
      },
      "additionalProperties": false
    },
    "record_hash": { "$ref": "#/$defs/sha256" },
    "hash_algorithm": { "const": "sha256:stable-json:v1" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "budget_amount": {
      "description": "A positive amount: an exact decimal string, or a number recorded by an earlier version.",
      "oneOf": [
        { "type": "null" },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$" }
      ]
    }
  },
  "additionalProperties": false
}
