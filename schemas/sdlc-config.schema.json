{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc-config.schema.json",
  "title": "Agentic SDLC Configuration v1",
  "type": "object",
  "required": [
    "config_schema_version",
    "schema_version",
    "kb_directories",
    "phase_order",
    "execution_policy",
    "assessment_workflow",
    "open_question_guidance",
    "budget_policy",
    "approval_policy",
    "authority_policy",
    "autonomy_policy",
    "verification_policy",
    "release_evidence_policy"
  ],
  "properties": {
    "config_schema_version": {
      "const": "sdlc-config:v1"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "kb_directories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
      }
    },
    "baseline_policy": {
      "type": "object",
      "required": [
        "source_extensions",
        "excluded_directories",
        "max_discovered_files",
        "max_file_bytes"
      ],
      "properties": {
        "source_extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          }
        },
        "excluded_directories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\]+$"
          }
        },
        "max_discovered_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "auto_approve_explained_refresh": {
          "type": "boolean"
        },
        "ignored_files": {
          "description": "exclude (default) leaves out files Git ignores, nested .gitignore files included; include also discovers them.",
          "enum": ["exclude", "include"]
        },
        "source_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          }
        },
        "test_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "phase_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "phases": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "runtime"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "assessment_workflow": {
      "$ref": "#/$defs/assessment_policy"
    },
    "open_question_guidance": {
      "$ref": "#/$defs/open_question_guidance"
    },
    "budget_policy": {
      "$ref": "#/$defs/budget_policy"
    },
    "context_optimization_policy": {
      "$ref": "#/$defs/context_optimization_policy"
    },
    "approval_policy": {
      "$ref": "#/$defs/approval_policy"
    },
    "authority_policy": {
      "type": "object",
      "required": ["mode", "usage_receipts_root", "allow_wildcards", "trusted_host_keys"],
      "properties": {
        "mode": { "enum": ["audit_only", "host_verified"] },
        "usage_receipts_root": { "type": "string", "minLength": 1 },
        "allow_wildcards": { "type": "boolean" },
        "default_ttl_seconds": { "type": "integer", "minimum": 0 },
        "trusted_host_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["key_id", "algorithm", "public_key"],
            "properties": {
              "key_id": { "type": "string", "minLength": 1 },
              "algorithm": { "const": "Ed25519" },
              "public_key": { "type": "string", "minLength": 1 },
              "not_before": { "type": "string", "format": "date-time", "description": "Receipts decided before this time do not verify with this key." },
              "not_after": { "type": "string", "format": "date-time", "description": "Receipts decided at or after this time do not verify with this key; earlier ones still do." },
              "retired": { "type": "boolean", "description": "A retired key keeps verifying receipts it signed while valid, but stops granting new authority immediately. Removing a key instead also invalidates the history it signed." }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "host_verified" } }, "required": ["mode"] },
          "then": { "properties": { "trusted_host_keys": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": true
    },
    "governance_policy": {
      "oneOf": [
        { "$ref": "governance-policy.schema.json" },
        { "$ref": "#/$defs/governance_policy_config" }
      ]
    },
    "autonomy_policy": {
      "$ref": "#/$defs/autonomy_policy"
    },
    "verification_policy": {
      "$ref": "#/$defs/verification_policy"
    },
    "release_evidence_policy": {
      "$ref": "#/$defs/release_policy"
    },
    "observability": {
      "$ref": "#/$defs/observability_policy"
    },
    "host_policy": {
      "type": "object",
      "properties": {
        "principle": {
          "type": "string"
        },
        "main_thread": {
          "enum": [
            "free",
            "orchestrator",
            "strict"
          ]
        },
        "records": {
          "type": "object",
          "properties": {
            "principle": {
              "type": "string"
            },
            "shared_history_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "evidence_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "waits": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "question_decide_after_minutes": { "type": "number", "exclusiveMinimum": 0 },
            "plugin_update_request_every_minutes": { "type": "number", "exclusiveMinimum": 0 },
            "freezes_enabled": { "type": "boolean" },
            "freeze_default_minutes": { "type": "number", "exclusiveMinimum": 0 },
            "explicit_default_until": { "type": "string", "pattern": "^[0-9]{1,9}[smhdw]?$" },
            "explicit_max_until": { "type": "string", "pattern": "^[0-9]{1,9}[smhdw]?$" },
            "escalate_approvals": { "type": "boolean" },
            "escalate_delegations": { "type": "boolean" },
            "list_limit": { "type": "integer", "minimum": 1 },
            "freeze_patterns": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "process_reaper": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "older_than_minutes": { "type": "number", "exclusiveMinimum": 0 },
            "reap_on_stop": { "type": "boolean" },
            "use_default_patterns": { "type": "boolean" },
            "include_patterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "exclude_patterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "scope_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "keep_going": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "max_consecutive_blocks": { "type": "integer", "minimum": 1, "maximum": 20 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "standing_approval_policy": {
      "type": "object",
      "properties": {
        "principle": { "type": "string" },
        "enabled": { "type": "boolean" },
        "max_validity_days": { "type": "integer", "minimum": 1 },
        "max_deliveries": { "type": "integer", "minimum": 1 },
        "max_changed_files": { "type": "integer", "minimum": 1 },
        "max_changed_lines": { "type": "integer", "minimum": 1 },
        "expiry_warning_hours": { "type": "integer", "minimum": 1 },
        "coordination": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "mode": { "enum": ["auto", "required", "local_only"] },
            "remote": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capability_discovery_policy": {
      "$ref": "#/$defs/capability_discovery_policy"
    },
    "orchestration_policy": {
      "type": "object",
      "properties": {
        "principle": { "type": "string" },
        "stale_claim_after_seconds": { "type": ["integer", "null"], "minimum": 60, "maximum": 31536000 },
        "status_list_limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "coordination": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "mode": { "enum": ["auto", "required", "local_only"] },
            "remote": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
          },
          "additionalProperties": false
        },
  "status_sync": {
    "type": "object",
    "properties": {
      "principle": {
        "type": "string"
      },
      "mode": {
        "enum": [
          "off",
          "fetch",
          "pull"
        ]
      }
    },
    "additionalProperties": false
  },
        "claim_identity": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "git_user": { "type": "boolean" },
            "host_label_env": { "type": ["string", "null"], "pattern": "^[A-Z_][A-Z0-9_]{0,99}$" }
          },
          "additionalProperties": false
        },
        "claim_activity": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "mode": { "enum": ["git", "off"] },
            "idle_after_seconds": { "type": ["integer", "null"], "minimum": 60, "maximum": 31536000 }
          },
          "additionalProperties": false
        },
        "reservation": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "default_expires_in_seconds": { "type": "integer", "minimum": 60, "maximum": 31536000 },
            "max_expires_in_seconds": { "type": "integer", "minimum": 60, "maximum": 31536000 }
          },
          "additionalProperties": false
        },
        "unclaimed_remote_work": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "mode": { "enum": ["git", "off"] },
            "pull_requests": { "enum": ["off", "github-cli"] },
            "recent_within_seconds": { "type": ["integer", "null"], "minimum": 60, "maximum": 31536000 }
          },
          "additionalProperties": false
        },
        "certification_drift": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "mode": { "enum": ["stale", "reopen"] },
            "ignored_files": { "enum": ["exclude", "include"] }
          },
          "additionalProperties": false
        },
        "workflow_history": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "check": { "enum": ["workflow", "project"] },
            "divergence": { "enum": ["warn", "off"] }
          },
          "additionalProperties": false
        },
        "story_records": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "in_branch": { "enum": ["include", "exclude"] },
            "before_pull_request": { "enum": ["warn", "refuse", "off"] },
            "publish_branch_prefix": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$" },
            "publish_pull_request": { "enum": ["off", "github-cli"] }
          },
          "additionalProperties": false
        },
        "merge_drift": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "mode": { "enum": ["git", "off"] },
            "base_branch": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$" },
            "match_commit_subject": { "type": "boolean" },
            "max_commits_scanned": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "open_state": { "enum": ["merged_open", "available"] }
          },
          "additionalProperties": false
        },
        "delivered_overlap": {
          "type": "object",
          "properties": {
            "principle": { "type": "string" },
            "write_scope": { "enum": ["confirm", "warn", "off"] },
            "context": { "enum": ["confirm", "warn", "off"] },
            "confirmation_actor": { "enum": ["any", "human"] },
            "claim": { "enum": ["warn", "off"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "capability_discovery_policy": {
      "type": "object",
      "properties": {
        "principle": { "type": "string" },
        "registry_path": { "type": "string", "minLength": 1 },
        "default_auto_use_installed": { "type": "boolean" },
        "default_auto_install": { "type": "boolean" },
        "require_approval_for_install": { "type": "boolean" },
        "require_approval_for_external_access": { "type": "boolean" },
        "require_approval_for_write_access": { "type": "boolean" },
        "require_approval_for_production": { "type": "boolean" },
        "source_priorities": { "type": "array", "items": { "type": "string" } },
        "agent_rules": { "type": "array", "items": { "type": "string" } },
        "inventory": { "$ref": "#/$defs/capability_inventory_policy" }
      },
      "additionalProperties": true
    },
    "capability_inventory_policy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "suggest": { "type": "boolean" },
        "limits": {
          "type": "object",
          "properties": {
            "max_entries": { "type": "integer", "minimum": 1, "maximum": 5000 },
            "max_directories": { "type": "integer", "minimum": 1, "maximum": 5000 },
            "max_listing_names": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "max_depth": { "type": "integer", "minimum": 1, "maximum": 8 },
            "max_frontmatter_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "max_config_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
            "max_description_chars": { "type": "integer", "minimum": 1, "maximum": 1000 }
          },
          "additionalProperties": false
        },
        "matching": {
          "type": "object",
          "properties": {
            "max_suggestions": { "type": "integer", "minimum": 1, "maximum": 25 },
            "min_tag_length": { "type": "integer", "minimum": 1, "maximum": 16 },
            "ignored_tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "ambiguous_tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "weak_tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "aliases": {
              "type": "object",
              "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
            },
            "exclude_names": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
            "phase_tags": {
              "type": "object",
              "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
            }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/capability_inventory_source" }
        }
      },
      "additionalProperties": false
    },
    "capability_inventory_source": {
      "type": "object",
      "required": ["id", "kind", "scope", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "kind": { "enum": ["skills", "commands", "plugins", "mcp-json", "mcp-toml"] },
        "scope": { "enum": ["project", "user"] },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))(?!.*\\$\\{(?!(?:CLAUDE_CONFIG_DIR|CODEX_HOME|HOME|USERPROFILE|XDG_CONFIG_HOME|APPDATA)(?::-[^}]*)?\\}))[^\\u0000\\\\]+$"
        },
        "enabled": { "type": "boolean" },
        "manifests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?![/~$])(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$"
          }
        },
        "skills_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?![/~$])(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$"
        },
        "commands_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?![/~$])(?!(?:.*/)?\\.\\.(?:/|$))[^\\u0000\\\\]+$"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        },
        "table": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
      },
      "additionalProperties": false
    },
    "governance_policy_config": {
      "type": "object",
      "required": [
        "mode",
        "policy_file",
        "decision_receipts_root",
        "use_receipts_root",
        "revocations_root",
        "fail_closed"
      ],
      "properties": {
        "mode": { "enum": ["audit", "enforce"] },
        "policy_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9.][A-Za-z0-9._/-]*$"
        },
        "decision_receipts_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9.][A-Za-z0-9._/-]*$"
        },
        "use_receipts_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9.][A-Za-z0-9._/-]*$"
        },
        "revocations_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9.][A-Za-z0-9._/-]*$"
        },
        "audit_events_root": {
          "description": "Optional operational audit-event root. Defaults outside .sdlc so identity-tree replacement cannot discard events.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9.][A-Za-z0-9._/-]*$"
        },
        "fail_closed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "enforce" } }, "required": ["mode"] },
          "then": { "properties": { "fail_closed": { "const": true } } }
        }
      ],
      "additionalProperties": false
    },
    "observability_policy": {
      "type": "object",
      "required": [
        "enabled",
        "external_sinks",
        "redaction",
        "correlation",
        "metrics",
        "readiness",
        "slo",
        "support_bundle"
      ],
      "properties": {
        "enabled": { "const": true },
        "external_sinks": { "const": "disabled" },
        "redaction": {
          "type": "object",
          "required": ["mode", "secret_patterns", "pii_patterns", "identifier_allow_patterns"],
          "properties": {
            "mode": { "const": "before_persistence_and_presentation" },
            "secret_patterns": {
              "type": "array",
              "items": { "$ref": "#/$defs/redaction_pattern" }
            },
            "pii_patterns": {
              "type": "array",
              "items": { "$ref": "#/$defs/redaction_pattern" }
            },
            "identifier_allow_patterns": {
              "type": "array",
              "items": { "$ref": "#/$defs/redaction_pattern" }
            },
            "sensitive_keys": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "correlation": {
          "type": "object",
          "required": ["enabled", "format"],
          "properties": {
            "enabled": { "const": true },
            "format": { "const": "corr-uuid" }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "required": ["enabled", "cardinality", "external_sinks"],
          "properties": {
            "enabled": { "const": true },
            "cardinality": { "const": "closed" },
            "external_sinks": { "const": "disabled" }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "required": ["liveness_is_shallow", "warm_before_ready"],
          "properties": {
            "liveness_is_shallow": { "const": true },
            "warm_before_ready": { "const": true }
          },
          "additionalProperties": false
        },
        "slo": {
          "type": "object",
          "required": ["mode", "availability_target", "readiness_target", "minimum_samples"],
          "properties": {
            "mode": { "const": "advisory" },
            "availability_target": { "type": "number", "minimum": 0, "maximum": 1 },
            "readiness_target": { "type": "number", "minimum": 0, "maximum": 1 },
            "minimum_samples": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "support_bundle": {
          "type": "object",
          "required": ["enabled", "max_recent_requests", "integrity", "authenticity_claimed"],
          "properties": {
            "enabled": { "const": true },
            "max_recent_requests": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "integrity": { "const": "sha256_of_redacted_canonical_content" },
            "authenticity_claimed": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "redaction_pattern": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 512 },
        {
          "type": "object",
          "required": ["name", "pattern"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "additionalProperties": false
        }
      ]
    },
    "autonomy_policy": {
      "type": "object",
      "required": [
        "enabled",
        "mode",
        "storage_root",
        "requirement_profile_schema",
        "delivery_profile_schema",
        "decision_schema",
        "allowed_levels",
        "default_requirement_ceiling",
        "legacy_default",
        "fail_closed_on_unknown",
        "require_explicit_delivery_selection",
        "bounded_autonomous_requires_host_verified",
        "delivery_kinds",
        "presets",
        "exception_triggers"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["off", "observe", "enforce_new_only", "enforce_all"] },
        "principle": { "type": "string", "minLength": 1 },
        "storage_root": { "type": "string", "minLength": 1 },
        "requirement_profile_schema": { "const": "schemas/requirement-execution-profile.schema.json" },
        "delivery_profile_schema": { "const": "schemas/delivery-execution-profile.schema.json" },
        "delivery_profile_schema_v2": { "const": "schemas/delivery-execution-profile-v2.schema.json" },
        "decision_schema": { "const": "schemas/autonomy-decision.schema.json" },
        "allowed_levels": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/autonomy_level" }
        },
        "default_requirement_ceiling": { "$ref": "#/$defs/autonomy_level" },
        "legacy_default": { "const": "supervised" },
        "fail_closed_on_unknown": { "type": "boolean" },
        "require_explicit_delivery_selection": { "type": "boolean" },
        "bounded_autonomous_requires_host_verified": { "type": "boolean" },
        "delivery_kinds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["pull_request", "local_release"] }
        },
        "presets": {
          "type": "object",
          "required": ["supervised", "checkpointed", "bounded-autonomous"],
          "properties": {
            "supervised": { "$ref": "#/$defs/autonomy_preset" },
            "checkpointed": { "$ref": "#/$defs/autonomy_preset" },
            "bounded-autonomous": { "$ref": "#/$defs/autonomy_preset" }
          },
          "additionalProperties": false
        },
        "exception_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "delivery_providers": {
          "type": "object",
          "required": ["git_push", "pull_request", "local_release"],
          "properties": {
            "git_push": { "$ref": "#/$defs/delivery_provider_id" },
            "pull_request": { "$ref": "#/$defs/delivery_provider_id" },
            "local_release": { "$ref": "#/$defs/delivery_provider_id" }
          },
          "additionalProperties": false
        },
        "pull_request": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "local_release": { "type": "object", "additionalProperties": { "type": "boolean" } }
      },
      "additionalProperties": true
    },
    "autonomy_level": {
      "enum": ["supervised", "checkpointed", "bounded-autonomous"]
    },
    "delivery_provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "autonomy_preset": {
      "type": "object",
      "required": ["automatic_phases", "checkpoints"],
      "properties": {
        "automatic_phases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "checkpoints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "context_optimization_policy": {
      "type": "object",
      "required": ["enabled", "mode", "fallback", "storage_root", "observation_schema", "provider", "telemetry", "budget_trigger_statuses"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["automatic", "manual", "disabled"] },
        "fallback": { "enum": ["native", "error"] },
        "storage_root": { "type": "string", "minLength": 1 },
        "observation_schema": { "const": "schemas/context-optimization-observation.schema.json" },
        "provider": {
          "type": "object",
          "required": ["id", "minimum_version", "command"],
          "properties": {
            "id": { "const": "rtk" },
            "minimum_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "command": {
              "type": "object",
              "required": ["executable", "arguments"],
              "properties": {
                "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "arguments": {
                  "type": "array",
                  "maxItems": 32,
                  "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "response_provider": {
          "type": "object",
          "required": [
            "id",
            "version",
            "skill",
            "mode",
            "default_intensity",
            "auto_clarity",
            "usage_accounting"
          ],
          "properties": {
            "id": { "const": "caveman" },
            "version": { "const": "1.9.1" },
            "skill": { "const": "../caveman/SKILL.md" },
            "mode": { "enum": ["adaptive", "disabled"] },
            "default_intensity": { "enum": ["lite", "full", "ultra"] },
            "auto_clarity": { "const": true },
            "usage_accounting": { "const": "measured_net_usage_only" }
          },
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "required": ["enabled", "include_in_budget_status", "auto_capture"],
          "properties": {
            "enabled": { "type": "boolean" },
            "include_in_budget_status": { "type": "boolean" },
            "auto_capture": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["apply", "checkpoint", "complete"] }
            }
          },
          "additionalProperties": false
        },
        "budget_trigger_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["warning", "soft_limit", "completion_reserve"] }
        }
      },
      "additionalProperties": false
    },
    "assessment_policy": {
      "type": "object",
      "required": [
        "normal_checkpoint_count",
        "normal_checkpoints",
        "requested_actions",
        "proposal_schema",
        "workflow_schema",
        "approval_schema",
        "application_schema",
        "task_start_receipt_schema",
        "storage_root",
        "paths",
        "exception_triggers"
      ],
      "properties": {
        "normal_checkpoint_count": {
          "const": 2
        },
        "normal_checkpoints": {
          "prefixItems": [
            {
              "const": "context"
            },
            {
              "const": "combined-proposal"
            }
          ],
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "requested_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "functional_analysis",
              "technical_analysis",
              "technical_assessment",
              "initial_technical_assessment",
              "project_technical_assessment",
              "project_assessment",
              "architecture_assessment",
              "technical_review"
            ]
          }
        },
        "proposal_schema": {
          "const": "schemas/assessment-proposal.schema.json"
        },
        "workflow_schema": {
          "const": "schemas/assessment-workflow.schema.json"
        },
        "approval_schema": {
          "const": "schemas/assessment-proposal-approval.schema.json"
        },
        "application_schema": {
          "const": "schemas/assessment-application.schema.json"
        },
        "task_start_receipt_schema": {
          "const": "schemas/task-start-receipt.schema.json"
        },
        "storage_root": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "exception_triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "open_question_guidance": {
      "type": "object",
      "required": ["fallback", "categories"],
      "properties": {
        "fallback": { "$ref": "#/$defs/question_guidance_fallback" },
        "categories": {
          "type": "object",
          "required": [
            "objective",
            "users_stakeholders",
            "constraints_nfr",
            "output_delivery",
            "integrations",
            "approval_boundaries",
            "budget_time"
          ],
          "properties": {
            "objective": { "$ref": "#/$defs/question_guidance_category" },
            "users_stakeholders": { "$ref": "#/$defs/question_guidance_category" },
            "constraints_nfr": { "$ref": "#/$defs/question_guidance_category" },
            "output_delivery": { "$ref": "#/$defs/question_guidance_category" },
            "integrations": { "$ref": "#/$defs/question_guidance_category" },
            "approval_boundaries": { "$ref": "#/$defs/question_guidance_category" },
            "budget_time": { "$ref": "#/$defs/question_guidance_category" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "question_guidance_fallback": {
      "type": "object",
      "required": ["why_needed", "example_answers", "effect_of_answer", "does_not_authorize"],
      "properties": {
        "why_needed": { "type": "string", "minLength": 1 },
        "example_answers": { "$ref": "#/$defs/bilingual_examples" },
        "effect_of_answer": { "type": "string", "minLength": 1 },
        "does_not_authorize": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "question_guidance_category": {
      "type": "object",
      "required": ["keywords", "why_needed", "example_answers", "effect_of_answer"],
      "properties": {
        "keywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "why_needed": { "type": "string", "minLength": 1 },
        "example_answers": { "$ref": "#/$defs/bilingual_examples" },
        "effect_of_answer": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "bilingual_examples": {
      "type": "object",
      "required": ["it", "en"],
      "properties": {
        "it": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "en": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "budget_policy": {
      "type": "object",
      "required": [
        "schema",
        "amendment_schema",
        "usage_receipt_schema",
        "metering_attestation_schema",
        "storage_root",
        "exact_metering",
        "defaults",
        "maxima",
        "presentation"
      ],
      "properties": {
        "schema": {
          "const": "schemas/execution-budget.schema.json"
        },
        "amendment_schema": {
          "const": "schemas/budget-amendment.schema.json"
        },
        "usage_receipt_schema": {
          "const": "schemas/execution-usage-receipt.schema.json"
        },
        "metering_attestation_schema": {
          "const": "schemas/metering-attestation.schema.json"
        },
        "storage_root": {
          "type": "string",
          "minLength": 1
        },
        "exact_metering": {
          "type": "object",
          "required": ["default_trust", "completion_freshness_seconds", "trusted_sources"],
          "properties": {
            "default_trust": { "const": "deny" },
            "completion_freshness_seconds": {
              "description": "Maximum age of the signed final cumulative observation at the completion checkpoint when no signed continuous-enforcement hook receipt is present.",
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "trusted_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["adapter", "metrics", "trusted_keys"],
                "properties": {
                  "adapter": { "type": "string", "minLength": 1 },
                  "metrics": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" }
                  },
                  "trusted_keys": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "required": ["key_id", "algorithm", "public_key"],
                      "properties": {
                        "key_id": { "type": "string", "minLength": 1 },
                        "algorithm": { "const": "Ed25519" },
                        "public_key": { "type": "string", "minLength": 1 }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "default_metering_adapter": {
          "enum": ["codex-session", "codeburn"]
        },
        "metering_adapters": {
          "type": "object",
          "properties": {
            "codex-session": {
              "type": "object",
              "required": ["enabled", "metric_mapping"],
              "properties": {
                "enabled": { "type": "boolean" },
                "metric_mapping": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
                  "additionalProperties": {
                    "enum": ["tokens.total", "tokens.input", "tokens.output", "tokens.cache_read", "tokens.cache_write", "calls"]
                  }
                }
              },
              "additionalProperties": false
            },
            "codeburn": {
              "type": "object",
              "required": ["enabled", "provider", "metric_mapping"],
              "properties": {
                "enabled": { "type": "boolean" },
                "provider": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                "command": {
                  "type": "object",
                  "required": ["executable", "arguments"],
                  "properties": {
                    "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
                    "arguments": {
                      "type": "array",
                      "maxItems": 32,
                      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                    }
                  },
                  "additionalProperties": false
                },
                "metric_mapping": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
                  "additionalProperties": {
                    "enum": ["tokens.total", "tokens.input", "tokens.output", "tokens.cache_read", "tokens.cache_write", "calls", "cost"]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "defaults": {
          "$ref": "#/$defs/budget_defaults"
        },
        "maxima": {
          "description": "Largest soft or hard limit a new proposal or budget amendment may set per metric: a whole number, or a decimal string (or {amount, currency}) for money metrics. The shape is checked when a budget is prepared or amended, so an older configuration stays loadable.",
          "type": "object",
          "additionalProperties": true
        },
        "warning_thresholds_percent": {
          "description": "Project-wide warning percentages (integers from 1 to 99); they take precedence over budget_policy.defaults unless a proposal's --budget-json sets its own. Checked when a budget is prepared."
        },
        "completion_reserve_percent": {
          "description": "Project-wide completion reserve (an integer from 0 to 50); it takes precedence over budget_policy.defaults unless a proposal's --budget-json sets its own. Checked when a budget is prepared."
        },
        "on_limit": {
          "description": "Only request_extension has an effect; checked when a budget is prepared."
        },
        "presentation": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "budget_defaults": {
      "type": "object",
      "required": [
        "warning_thresholds_percent",
        "completion_reserve_percent",
        "scope",
        "limits",
        "limit_policy",
        "extensions"
      ],
      "properties": {
        "warning_thresholds_percent": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 99 }
        },
        "completion_reserve_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "object",
          "minProperties": 1,
          "description": "Default limits for a new proposal. Soft limits pause for a decision; a hard limit is optional and needs exact metering from a trusted signed source.",
          "properties": {
            "active_time_seconds": {
              "allOf": [
                { "$ref": "#/$defs/budget_limit_input" },
                {
                  "properties": {
                    "unit": { "const": "seconds" }
                  }
                }
              ]
            },
            "steps": {
              "allOf": [
                { "$ref": "#/$defs/budget_limit_input" },
                {
                  "properties": {
                    "unit": { "const": "steps" }
                  }
                }
              ]
            },
            "tokens": {
              "allOf": [
                { "$ref": "#/$defs/budget_limit_input" },
                {
                  "required": ["soft"],
                  "properties": {
                    "unit": { "const": "tokens" },
                    "metering": { "const": "estimated" }
                  },
                  "not": { "required": ["hard"] }
                }
              ]
            }
          },
          "additionalProperties": { "$ref": "#/$defs/budget_limit_input" }
        },
        "limit_policy": {
          "type": "object",
          "required": ["on_warning", "on_soft_limit", "on_hard_limit", "on_metering_violation"],
          "description": "Only notify, checkpoint, stop, and stop have an effect; other values are refused when a budget is prepared.",
          "additionalProperties": true
        },
        "extensions": {
          "type": "object",
          "description": "automatic_extension must be false and on_limit must be request_extension; checked when a budget is prepared.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "budget_limit_input": {
      "type": "object",
      "required": ["unit", "metering"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "metering": { "enum": ["exact", "estimated", "unavailable"] },
        "soft": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }
          ]
        },
        "hard": {
          "description": "Optional hard stop; it needs exact metering. null states explicitly that there is no hard limit.",
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{2,7}$"
        }
      },
      "anyOf": [
        { "required": ["soft"] },
        { "required": ["hard"], "properties": { "hard": { "not": { "type": "null" } } } }
      ],
      "allOf": [
        {
          "if": { "required": ["hard"], "properties": { "hard": { "not": { "type": "null" } } } },
          "then": { "properties": { "metering": { "const": "exact" } } }
        }
      ],
      "additionalProperties": false
    },
    "approval_policy": {
      "type": "object",
      "required": [
        "formal_approval_requires_explicit_source"
      ],
      "additionalProperties": true
    },
    "verification_policy": {
      "type": "object",
      "required": [
        "receipt_schema",
        "generator_receipt_schema",
        "dimensions",
        "require_generator_receipt"
      ],
      "properties": {
        "receipt_schema": {
          "const": "schemas/verification-receipt.schema.json"
        },
        "generator_receipt_schema": {
          "const": "schemas/artifact-generator-receipt.schema.json"
        },
        "require_generator_receipt": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "array",
          "prefixItems": [
            {
              "const": "container_verified"
            },
            {
              "const": "content_verified"
            },
            {
              "const": "render_verified"
            }
          ],
          "minItems": 3
        }
      },
      "additionalProperties": true
    },
    "release_policy": {
      "type": "object",
      "required": [
        "manifest_schema",
        "gate_receipt_schema",
        "archive_schema",
        "archive_plan_schema",
        "manifest_directory",
        "gate_receipt_directory",
        "archive_directory"
      ],
      "properties": {
        "manifest_schema": {
          "const": "schemas/release-manifest.schema.json"
        },
        "gate_receipt_schema": {
          "const": "schemas/release-gate-receipt.schema.json"
        },
        "archive_schema": {
          "const": "schemas/archive-record.schema.json"
        },
        "archive_plan_schema": {
          "const": "schemas/archive-plan.schema.json"
        },
        "manifest_directory": {
          "type": "string",
          "minLength": 1
        },
        "gate_receipt_directory": {
          "type": "string",
          "minLength": 1
        },
        "archive_directory": {
          "type": "string",
          "minLength": 1
        },
        "max_future_skew_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
