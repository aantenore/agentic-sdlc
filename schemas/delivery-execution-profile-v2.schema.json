{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-execution-profile-v2.schema.json",
  "title": "Agentic SDLC Delivery Execution Profile v2",
  "description": "Per-delivery autonomy with explicit, hash-bound verification-provider bindings. Provider bindings prove state but never execute delivery operations.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "version",
    "id",
    "status",
    "delivery_id",
    "delivery_kind",
    "requirement_profile_refs",
    "story_refs",
    "contract_refs",
    "material_scope",
    "material_scope_hash",
    "requested_level",
    "phase_levels",
    "constraints",
    "checkpoints",
    "use_policy",
    "pull_request_target",
    "local_release_target",
    "provider_bindings",
    "provider_bindings_hash",
    "authority_assurance",
    "approval_ref",
    "valid_from",
    "expires_at",
    "created_at",
    "updated_at",
    "extensions",
    "profile_hash",
    "hash_algorithm"
  ],
  "properties": {
    "kind": { "const": "delivery_execution_profile" },
    "schema_version": { "const": "delivery-execution-profile:v2" },
    "version": { "const": 2 },
    "id": { "$ref": "delivery-execution-profile.schema.json#/properties/id" },
    "status": { "$ref": "delivery-execution-profile.schema.json#/properties/status" },
    "delivery_id": { "$ref": "delivery-execution-profile.schema.json#/properties/delivery_id" },
    "delivery_kind": { "$ref": "delivery-execution-profile.schema.json#/properties/delivery_kind" },
    "requirement_profile_refs": { "$ref": "delivery-execution-profile.schema.json#/properties/requirement_profile_refs" },
    "story_refs": { "$ref": "delivery-execution-profile.schema.json#/properties/story_refs" },
    "contract_refs": { "$ref": "delivery-execution-profile.schema.json#/properties/contract_refs" },
    "material_scope": { "$ref": "delivery-execution-profile.schema.json#/properties/material_scope" },
    "material_scope_hash": { "$ref": "delivery-execution-profile.schema.json#/properties/material_scope_hash" },
    "requested_level": { "$ref": "delivery-execution-profile.schema.json#/properties/requested_level" },
    "effective_level": { "$ref": "delivery-execution-profile.schema.json#/properties/effective_level" },
    "phase_levels": { "$ref": "delivery-execution-profile.schema.json#/properties/phase_levels" },
    "constraints": { "$ref": "delivery-execution-profile.schema.json#/properties/constraints" },
    "checkpoints": { "$ref": "delivery-execution-profile.schema.json#/properties/checkpoints" },
    "use_policy": { "$ref": "delivery-execution-profile.schema.json#/properties/use_policy" },
    "pull_request_target": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pull_request_target_v2" }
      ]
    },
    "local_release_target": { "$ref": "delivery-execution-profile.schema.json#/properties/local_release_target" },
    "provider_bindings": { "type": "array", "uniqueItems": true },
    "provider_bindings_hash": { "$ref": "delivery-execution-profile.schema.json#/$defs/sha256" },
    "authority_assurance": { "$ref": "delivery-execution-profile.schema.json#/properties/authority_assurance" },
    "approval_ref": { "$ref": "delivery-execution-profile.schema.json#/properties/approval_ref" },
    "valid_from": { "$ref": "delivery-execution-profile.schema.json#/properties/valid_from" },
    "expires_at": { "$ref": "delivery-execution-profile.schema.json#/properties/expires_at" },
    "created_at": { "$ref": "delivery-execution-profile.schema.json#/properties/created_at" },
    "updated_at": { "$ref": "delivery-execution-profile.schema.json#/properties/updated_at" },
    "extensions": { "$ref": "delivery-execution-profile.schema.json#/properties/extensions" },
    "profile_hash": { "$ref": "delivery-execution-profile.schema.json#/properties/profile_hash" },
    "hash_algorithm": { "$ref": "delivery-execution-profile.schema.json#/properties/hash_algorithm" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
      "then": { "properties": { "approval_ref": { "$ref": "delivery-execution-profile.schema.json#/$defs/hashed_ref" } } }
    },
    {
      "if": { "properties": { "delivery_kind": { "const": "pull_request" } }, "required": ["delivery_kind"] },
      "then": {
        "properties": {
          "pull_request_target": { "$ref": "#/$defs/pull_request_target_v2" },
          "local_release_target": { "type": "null" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "pull_request_target": {
                  "properties": { "mode": { "const": "existing" } },
                  "required": ["mode"]
                }
              },
              "required": ["pull_request_target"]
            },
            "then": {
              "properties": {
                "provider_bindings": { "$ref": "#/$defs/existing_pr_bindings" }
              }
            },
            "else": {
              "properties": {
                "provider_bindings": { "$ref": "#/$defs/new_pr_bindings" }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "pull_request_target": { "type": "null" },
          "local_release_target": { "$ref": "delivery-execution-profile.schema.json#/$defs/local_release_target" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "local_release_target": {
                  "properties": {
                    "allowed_actions": { "contains": { "const": "data.migrate" } }
                  },
                  "required": ["allowed_actions"]
                }
              },
              "required": ["local_release_target"]
            },
            "then": {
              "allOf": [
                {
                  "if": { "$ref": "#/$defs/local_rollback_verification_enabled" },
                  "then": {
                    "properties": {
                      "provider_bindings": { "$ref": "#/$defs/local_data_verified_release_bindings" }
                    }
                  },
                  "else": {
                    "properties": {
                      "provider_bindings": { "$ref": "#/$defs/local_data_release_bindings" }
                    }
                  }
                }
              ]
            },
            "else": {
              "allOf": [
                {
                  "if": { "$ref": "#/$defs/local_rollback_verification_enabled" },
                  "then": {
                    "properties": {
                      "provider_bindings": { "$ref": "#/$defs/local_verified_release_bindings" }
                    }
                  },
                  "else": {
                    "properties": {
                      "provider_bindings": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "prefixItems": [{ "$ref": "#/$defs/local_release_binding" }]
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "requested_level": { "const": "supervised" } }, "required": ["requested_level"] },
      "then": { "properties": { "phase_levels": { "$ref": "delivery-execution-profile.schema.json#/$defs/supervised_phase_levels" } } }
    },
    {
      "if": { "properties": { "requested_level": { "const": "checkpointed" } }, "required": ["requested_level"] },
      "then": { "properties": { "phase_levels": { "$ref": "delivery-execution-profile.schema.json#/$defs/checkpointed_phase_levels" } } }
    },
    {
      "if": { "properties": { "effective_level": { "const": "supervised" } }, "required": ["effective_level"] },
      "then": { "properties": { "phase_levels": { "$ref": "delivery-execution-profile.schema.json#/$defs/supervised_phase_levels" } } }
    },
    {
      "if": { "properties": { "effective_level": { "const": "checkpointed" } }, "required": ["effective_level"] },
      "then": { "properties": { "phase_levels": { "$ref": "delivery-execution-profile.schema.json#/$defs/checkpointed_phase_levels" } } }
    }
  ],
  "$defs": {
    "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "pull_request_target_v2": {
      "type": "object",
      "required": ["repository", "base_branch", "head_branch", "allowed_actions", "merge_allowed"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "base_branch": { "type": "string", "minLength": 1 },
        "head_branch": { "type": "string", "minLength": 1 },
        "allowed_actions": { "$ref": "delivery-execution-profile.schema.json#/$defs/string_list" },
        "merge_allowed": { "type": "boolean" },
        "mode": { "enum": ["new", "existing"] },
        "pr_number": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "pr_url": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[1-9][0-9]*$" }
          ]
        },
        "reviewed_head_sha": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
          ]
        },
        "code_review": { "$ref": "#/$defs/code_review_decision" },
        "merge_decision": { "$ref": "#/$defs/merge_decision" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "existing" } },
            "required": ["mode"]
          },
          "then": {
            "required": ["pr_number", "pr_url", "reviewed_head_sha"],
            "properties": {
              "pr_number": { "type": "integer", "minimum": 1 },
              "pr_url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[1-9][0-9]*$" },
              "allowed_actions": {
                "not": { "contains": { "const": "pull_request.create" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "new" } },
            "required": ["mode"]
          },
          "then": {
            "required": ["pr_number", "pr_url", "reviewed_head_sha"],
            "properties": {
              "pr_number": { "type": "null" },
              "pr_url": { "type": "null" },
              "reviewed_head_sha": { "type": "null" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "merge_decision": {
      "type": "object",
      "description": "The person's choice of how this pull request is merged: manual (the person merges it on GitHub and the delivery is reconciled), after-confirmation (the plugin merges after a confirmation), or automatic (the plugin merges without a merge confirmation once every other gate passes).",
      "required": ["mode", "source", "actor_id", "user_words", "decided_at"],
      "properties": {
        "mode": { "enum": ["manual", "after-confirmation", "automatic"] },
        "source": { "enum": ["explicit-user", "delegation"] },
        "actor_id": { "type": "string", "minLength": 1 },
        "user_words": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "delegation_id": { "type": "string", "pattern": "^DLG-" }
      },
      "if": { "properties": { "source": { "const": "delegation" } } },
      "then": { "required": ["delegation_id"] },
      "else": { "not": { "required": ["delegation_id"] } },
      "additionalProperties": false
    },
    "code_review_decision": {
      "type": "object",
      "description": "The person's choice of whether this pull request needs a code review before the plugin merges it. Checked only at pull_request.merge.",
      "required": ["decision", "source", "actor_id", "user_words", "standing_approval_id", "decided_at"],
      "properties": {
        "decision": { "enum": ["required", "not-required"] },
        "source": { "enum": ["explicit-user", "standing-approval", "delegation"] },
        "actor_id": { "type": ["string", "null"] },
        "user_words": { "type": ["string", "null"] },
        "standing_approval_id": { "type": ["string", "null"] },
        "decided_at": { "type": "string", "format": "date-time" },
        "delegation_id": { "type": "string", "pattern": "^DLG-" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "explicit-user" } } },
          "then": {
            "properties": {
              "actor_id": { "type": "string", "minLength": 1 },
              "user_words": { "type": "string", "minLength": 1 },
              "standing_approval_id": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "standing-approval" } } },
          "then": {
            "properties": {
              "actor_id": { "type": "null" },
              "user_words": { "type": "null" },
              "standing_approval_id": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "delegation" } } },
          "then": {
            "required": ["delegation_id"],
            "properties": {
              "actor_id": { "type": "string", "minLength": 1 },
              "user_words": { "type": "string", "minLength": 1 },
              "standing_approval_id": { "type": "null" }
            }
          },
          "else": { "not": { "required": ["delegation_id"] } }
        }
      ],
      "additionalProperties": false
    },
    "new_pr_bindings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/git_push_binding" },
        { "$ref": "#/$defs/pr_create_binding" },
        { "$ref": "#/$defs/pr_merge_binding" },
        { "$ref": "#/$defs/pr_update_binding" }
      ]
    },
    "existing_pr_bindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/git_push_binding" },
        { "$ref": "#/$defs/pr_merge_binding" },
        { "$ref": "#/$defs/pr_update_binding" }
      ]
    },
    "git_push_binding": {
      "type": "object",
      "required": ["action", "provider_id"],
      "properties": { "action": { "const": "git.push" }, "provider_id": { "$ref": "#/$defs/provider_id" } },
      "additionalProperties": false
    },
    "pr_create_binding": {
      "type": "object",
      "required": ["action", "provider_id"],
      "properties": { "action": { "const": "pull_request.create" }, "provider_id": { "$ref": "#/$defs/provider_id" } },
      "additionalProperties": false
    },
    "pr_merge_binding": {
      "type": "object",
      "required": ["action", "provider_id"],
      "properties": { "action": { "const": "pull_request.merge" }, "provider_id": { "$ref": "#/$defs/provider_id" } },
      "additionalProperties": false
    },
    "pr_update_binding": {
      "type": "object",
      "required": ["action", "provider_id"],
      "properties": { "action": { "const": "pull_request.update" }, "provider_id": { "$ref": "#/$defs/provider_id" } },
      "additionalProperties": false
    },
    "local_release_binding": {
      "type": "object",
      "required": ["action", "provider_id"],
      "properties": { "action": { "const": "release.local" }, "provider_id": { "$ref": "#/$defs/provider_id" } },
      "additionalProperties": false
    },
    "rollback_verify_binding": {
      "type": "object",
      "required": ["action", "provider_id"],
      "properties": { "action": { "const": "rollback.verify" }, "provider_id": { "$ref": "#/$defs/provider_id" } },
      "additionalProperties": false
    },
    "local_rollback_verification_enabled": {
      "properties": {
        "local_release_target": {
          "properties": {
            "rollback": {
              "properties": { "verification_required": { "const": true } },
              "required": ["verification_required"]
            }
          },
          "required": ["rollback"]
        }
      },
      "required": ["local_release_target"]
    },
    "local_verified_release_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/local_release_binding" },
        { "$ref": "#/$defs/rollback_verify_binding" }
      ]
    },
    "local_data_release_bindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/data_migrate_binding" },
        { "$ref": "#/$defs/data_rollback_binding" },
        { "$ref": "#/$defs/local_release_binding" }
      ]
    },
    "local_data_verified_release_bindings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/data_migrate_binding" },
        { "$ref": "#/$defs/data_rollback_binding" },
        { "$ref": "#/$defs/local_release_binding" },
        { "$ref": "#/$defs/rollback_verify_binding" }
      ]
    },
    "data_migrate_binding": {
      "type": "object",
      "required": ["action", "provider_id"],
      "properties": { "action": { "const": "data.migrate" }, "provider_id": { "$ref": "#/$defs/provider_id" } },
      "additionalProperties": false
    },
    "data_rollback_binding": {
      "type": "object",
      "required": ["action", "provider_id"],
      "properties": { "action": { "const": "data.rollback" }, "provider_id": { "$ref": "#/$defs/provider_id" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
