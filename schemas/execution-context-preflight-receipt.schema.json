{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-context-preflight-receipt.schema.json",
  "title": "Immutable execution context preflight receipt",
  "type": "object",
  "required": [
    "id",
    "kind",
    "schema_version",
    "story_ref",
    "contract_ref",
    "delivery_profile_ref",
    "requirement_scopes",
    "source_snapshots",
    "workspace_changes",
    "git_head_sha",
    "status",
    "created_by",
    "created_at",
    "audit",
    "hash_algorithm",
    "receipt_hash"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "execution_context_preflight_receipt" },
    "schema_version": { "const": "execution-context-preflight-receipt:v1" },
    "story_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
    "contract_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
    "delivery_profile_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
    "requirement_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profile_ref", "allowed_write_paths"],
        "properties": {
          "profile_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
          "allowed_write_paths": { "$ref": "#/$defs/string_list" }
        },
        "additionalProperties": false
      }
    },
    "source_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bindings", "disposition"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "file_type": { "const": "regular" },
          "mode": { "$ref": "#/$defs/file_mode" },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "id", "record_path", "expected_sha256"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "id": { "type": "string", "minLength": 1 },
                "record_path": { "type": "string", "minLength": 1 },
                "expected_sha256": { "$ref": "#/$defs/sha256" }
              },
              "additionalProperties": false
            }
          },
          "disposition": { "enum": ["authorized_evolution", "immutable_context"] }
        },
        "additionalProperties": false
      }
    },
    "workspace_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status", "content_sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "file_type": { "enum": ["regular", "symlink", "missing"] },
          "mode": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/file_mode" }
            ]
          },
          "content_sha256": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/sha256" }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "git_head_sha": {
      "description": "The commit HEAD pointed at, or null when HEAD was unborn; then git_base_tree names the empty tree.",
      "oneOf": [
        { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        { "type": "null" }
      ]
    },
    "git_base_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "status": { "const": "passed" },
    "created_by": { "$ref": "common.schema.json#/$defs/actor" },
    "created_at": { "type": "string", "format": "date-time" },
    "audit": { "$ref": "common.schema.json#/$defs/audit" },
    "hash_algorithm": { "const": "sha256:stable-json:v1" },
    "receipt_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file_mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "path_hashed_id_ref": {
      "type": "object",
      "required": ["id", "path", "hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "git_head_sha": { "type": "null" } } },
      "then": { "required": ["git_base_tree"] },
      "else": { "not": { "required": ["git_base_tree"] } }
    }
  ],
  "additionalProperties": false
}
