{
  "name": "agentic-sdlc",
  "version": "0.16.0",
  "description": "Contract-driven delivery, verified assessments, and visual project lineage for Codex and Claude Code.",
  "type": "module",
  "bin": {
    "agentic-sdlc": "./bin/agentic-sdlc.mjs"
  },
  "engines": {
    "node": "^18.20.3 || ^20.12.0 || >=21.6.0"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/plugin.json",
    "assets/",
    "bin/",
    "commands/",
    "config/",
    "docs/",
    "lib/",
    "schemas/",
    "scripts/",
    "skills/",
    "templates/",
    "ui/"
  ],
  "scripts": {
    "benchmark:enterprise": "node scripts/benchmark-enterprise-performance.mjs --enforce",
    "check": "node scripts/check-source-syntax.mjs",
    "doctor": "node bin/agentic-sdlc.mjs doctor",
    "smoke": "node bin/agentic-sdlc.mjs --help",
    "test": "node scripts/run-test-suite.mjs",
    "test:enterprise": "npm test && npm run benchmark:enterprise"
  },
  "keywords": [
    "codex",
    "claude-code",
    "sdlc",
    "agentic",
    "knowledge-base",
    "observability",
    "explainability"
